<%- include('follow-button', { targetUsername: targetUser.username, targetUserId: targetUser.id, isFollowing, csrfToken }) %>
<div
  id="follow-count-<%= targetUser.id %>"
  hx-swap-oob="outerHTML"
  class="flex gap-4 text-sm text-gray-500 mt-3"
>
  <a href="/u/<%= targetUser.username %>/followers" class="hover:underline">
    <strong class="text-gray-900"><%= followerCount ?? 0 %></strong> followers
  </a>
  <a href="/u/<%= targetUser.username %>/following" class="hover:underline">
    <strong class="text-gray-900"><%= followingCount ?? 0 %></strong> following
  </a>
</div>
