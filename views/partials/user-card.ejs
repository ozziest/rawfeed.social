<div
  class="flex items-center justify-between gap-4 p-4 bg-white rounded-lg border border-gray-100 hover:border-gray-200 transition-colors"
>
  <a href="/u/<%= cardUser.username %>" class="flex items-center gap-3 min-w-0">
    <img
      src="<%= getAvatar(cardUser) %>"
      alt="<%= cardUser.name %>"
      class="w-12 h-12 rounded-full border border-gray-200 shrink-0"
    />
    <div class="min-w-0">
      <p class="font-semibold text-gray-900 truncate"><%= cardUser.name %></p>
      <p class="text-sm text-gray-500 truncate">@<%= cardUser.username %></p>
      <% if (cardUser.bio) { %>
      <p class="text-sm text-gray-600 truncate mt-0.5"><%= cardUser.bio %></p>
      <% } %>
    </div>
  </a>
  <% if (loggedUser && loggedUser.userId !== cardUser.id) { %>
  <%- include('follow-button', {
      targetUsername: cardUser.username,
      targetUserId: cardUser.id,
      isFollowing,
      csrfToken
    }) %>
  <% } %>
</div>
